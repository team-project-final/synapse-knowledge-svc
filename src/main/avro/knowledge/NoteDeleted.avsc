{
  "type": "record",
  "name": "NoteDeleted",
  "namespace": "com.synapse.knowledge",
  "doc": "Emitted when a note is soft deleted.",
  "fields": [
    {"name": "eventId", "type": "string", "default": "", "doc": "Unique event ID (UUID) — idempotency key (common meta, EVENT_CONTRACT_STANDARD §1)"},
    {"name": "noteId", "type": "string", "doc": "UUID of the deleted note"},
    {"name": "userId", "type": "string", "doc": "UUID of the note author"},
    {"name": "tenantId", "type": "string", "doc": "Tenant identifier"},
    {"name": "title", "type": "string", "default": "", "doc": "Note title for observability"},
    {"name": "deletedAt", "type": "string", "default": "", "doc": "Note deletion time encoded as epoch millis string for v1 compatibility"},
    {"name": "occurredAt", "type": "long", "default": 0, "doc": "Event emission time (epoch millis) — common meta"}
  ]
}
